# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000)
PORT=3000

# Optional: Real email delivery to contact@madtronixsystems.com via Resend API
# If left unset, inquiries are saved to /data/inquiries.json and logged to server console
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Madtronix Inquiries <onboarding@resend.dev>"
NOTIFICATION_EMAIL="contact@madtronixsystems.com"

# Optional: Webhook URL (Slack, Discord, Zapier) for instant push notifications
NOTIFICATION_WEBHOOK_URL=""
